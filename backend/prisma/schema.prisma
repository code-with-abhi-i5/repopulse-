generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String       @id @default(uuid())
  githubId   Int?         @unique
  login      String       @unique
  name       String?
  email      String?      @unique
  password   String?
  avatarUrl  String?
  role       UserRole     @default(DEVELOPER)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  alertRules AlertRule[]
  reports    Report[]
  teams      TeamMember[]
}

model Team {
  id             String       @id @default(uuid())
  name           String
  hackathonBatch String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  repositories   Repository[]
  members        TeamMember[]
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Repository {
  id              String               @id @default(uuid())
  githubId        BigInt               @unique
  name            String
  fullName        String               @unique
  owner           String
  description     String?
  visibility      RepoVisibility       @default(PUBLIC)
  defaultBranch   String               @default("main")
  license         String?
  language        String?
  createdAt       DateTime
  updatedAt       DateTime
  pushedAt        DateTime
  stars           Int                  @default(0)
  forks           Int                  @default(0)
  watchers        Int                  @default(0)
  openIssues      Int                  @default(0)
  sizeKb          Int                  @default(0)
  archived        Boolean              @default(false)
  topics          String[]             @default([])
  healthScore     Float                @default(100.0)
  teamId          String?
  teamName        String?
  hackathonBatch  String?
  antiCheatStatus AntiCheatStatus      @default(AUDIT_PENDING)
  webhookActive   Boolean              @default(false)
  createdAtSystem DateTime             @default(now())
  updatedAtSystem DateTime             @updatedAt
  activities      ActivityEvent[]
  alerts          Alert[]
  alertRules      AlertRule[]
  auditLogs       AntiCheatAuditLog[]
  commits         Commit[]
  issues          Issue[]
  pullRequests    PullRequest[]
  team            Team?                @relation(fields: [teamId], references: [id])
  snapshots       RepositorySnapshot[]
  securityAlerts  SecurityAlert[]
  workflows       WorkflowRun[]

  @@index([owner])
  @@index([language])
  @@index([antiCheatStatus])
  @@index([teamId])
}

model RepositorySnapshot {
  id           String     @id @default(uuid())
  repositoryId String
  date         DateTime   @db.Date
  commits      Int        @default(0)
  additions    Int        @default(0)
  deletions    Int        @default(0)
  stars        Int        @default(0)
  forks        Int        @default(0)
  watchers     Int        @default(0)
  openIssues   Int        @default(0)
  contributors Int        @default(0)
  healthScore  Float      @default(0.0)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, date])
  @@index([date])
}

model Contributor {
  id            String          @id @default(uuid())
  login         String          @unique
  name          String?
  avatarUrl     String?
  totalCommits  Int             @default(0)
  pushesCount   Int             @default(0)
  teamName      String?
  primaryRepo   String?
  additions     Int             @default(0)
  deletions     Int             @default(0)
  activeDays    Int             @default(0)
  firstCommitAt DateTime?
  lastCommitAt  DateTime?
  currentStreak Int             @default(0)
  longestStreak Int             @default(0)
  isBot         Boolean         @default(false)
  repositories  String[]        @default([])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  activities    ActivityEvent[]
  commits       Commit[]
  issues        Issue[]
  pullRequests  PullRequest[]

  @@index([login])
}

model Commit {
  id           String       @id @default(uuid())
  sha          String       @unique
  message      String
  authorLogin  String
  branch       String       @default("main")
  repositoryId String
  timestamp    DateTime
  additions    Int          @default(0)
  deletions    Int          @default(0)
  filesChanged Int          @default(0)
  url          String
  isBulkDump   Boolean      @default(false)
  author       Contributor  @relation(fields: [authorLogin], references: [login])
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  files        CommitFile[]

  @@index([repositoryId, timestamp])
  @@index([authorLogin])
}

model CommitFile {
  id        String @id @default(uuid())
  commitId  String
  filename  String
  status    String
  additions Int    @default(0)
  deletions Int    @default(0)
  commit    Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@index([commitId])
}

model PullRequest {
  id                 String      @id @default(uuid())
  number             Int
  title              String
  state              PRState     @default(OPEN)
  authorLogin        String
  repositoryId       String
  createdAt          DateTime
  updatedAt          DateTime
  mergedAt           DateTime?
  closedAt           DateTime?
  additions          Int         @default(0)
  deletions          Int         @default(0)
  filesChanged       Int         @default(0)
  reviewLatencyHours Float?
  mergeTimeHours     Float?
  isDraft            Boolean     @default(false)
  url                String
  labels             Json        @default("[]")
  reviewers          Json        @default("[]")
  author             Contributor @relation(fields: [authorLogin], references: [login])
  repository         Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number])
  @@index([repositoryId, state])
}

model Issue {
  id                 String      @id @default(uuid())
  number             Int
  title              String
  state              IssueState  @default(OPEN)
  authorLogin        String
  repositoryId       String
  createdAt          DateTime
  updatedAt          DateTime
  closedAt           DateTime?
  firstResponseAt    DateTime?
  firstResponseHours Float?
  isStale            Boolean     @default(false)
  url                String
  labels             Json        @default("[]")
  author             Contributor @relation(fields: [authorLogin], references: [login])
  repository         Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number])
  @@index([repositoryId, state])
}

model ActivityEvent {
  id             String            @id @default(uuid())
  type           ActivityEventType
  repositoryId   String
  repositoryName String
  teamName       String?
  actorLogin     String
  actorName      String?
  actorAvatarUrl String?
  timestamp      DateTime          @default(now())
  title          String
  description    String?
  url            String?
  branch         String?
  linesAdded     Int?              @default(0)
  linesDeleted   Int?              @default(0)
  commitCount    Int?              @default(0)
  commitSha      String?
  actor          Contributor       @relation(fields: [actorLogin], references: [login])
  repository     Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, timestamp(sort: Desc)])
  @@index([type])
}

model AlertRule {
  id              String        @id @default(uuid())
  userId          String?
  name            String
  event           String
  condition       String
  repositoryId    String
  repositoryName  String
  channel         AlertChannel
  webhookUrl      String?
  destination     String?
  severity        AlertSeverity @default(WARNING)
  state           AlertState    @default(ACTIVE)
  throttleMinutes Int           @default(15)
  quietHoursStart String?
  quietHoursEnd   String?
  lastTriggeredAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  alerts          Alert[]
  repository      Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id])

  @@index([repositoryId, state])
}

model Alert {
  id           String        @id @default(uuid())
  ruleId       String?
  repositoryId String
  type         String
  severity     AlertSeverity
  repository   String
  message      String
  channel      AlertChannel
  read         Boolean       @default(false)
  createdAt    DateTime      @default(now())
  repoRelation Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  rule         AlertRule?    @relation(fields: [ruleId], references: [id])

  @@index([repositoryId, createdAt(sort: Desc)])
  @@index([read])
}

model WorkflowRun {
  id           String         @id @default(uuid())
  runId        BigInt         @unique
  name         String
  repositoryId String
  status       WorkflowStatus
  branch       String
  sha          String
  duration     Int            @default(0)
  createdAt    DateTime
  url          String
  repository   Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, status])
}

model SecurityAlert {
  id           String           @id @default(uuid())
  alertId      BigInt           @unique
  severity     SecuritySeverity
  category     SecurityCategory
  title        String
  repositoryId String
  createdAt    DateTime
  url          String
  repository   Repository       @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, severity])
}

model AntiCheatAuditLog {
  id               String          @id @default(uuid())
  repositoryId     String
  evaluatedStatus  AntiCheatStatus
  hackathonStart   DateTime
  firstCommitDate  DateTime
  flaggedCommits   Json            @default("[]")
  aiSuspicionScore Float           @default(0.0)
  reasonSummary    String
  auditedAt        DateTime        @default(now())
  repository       Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, evaluatedStatus])
}

model Report {
  id                String   @id @default(uuid())
  userId            String?
  title             String
  period            String
  health            Float
  healthChange      Float
  commits           Int
  prsMerged         Int
  issuesClosed      Int
  topContributor    String
  repositories      Int
  aiSummaryMarkdown String?
  generatedAt       DateTime @default(now())
  user              User?    @relation(fields: [userId], references: [id])

  @@index([generatedAt(sort: Desc)])
}

enum UserRole {
  ADMIN
  ORGANIZER
  TEAM_LEAD
  DEVELOPER
  JUDGE
}

enum RepoVisibility {
  PUBLIC
  PRIVATE
}

enum AntiCheatStatus {
  VERIFIED_FRESH
  PRE_EXISTING_FLAG
  AUDIT_PENDING
}

enum PRState {
  OPEN
  MERGED
  CLOSED
}

enum IssueState {
  OPEN
  CLOSED
}

enum ActivityEventType {
  PUSH
  PULL_REQUEST
  ISSUES
  RELEASE
  WORKFLOW_RUN
  STAR
  FORK
  FORCE_PUSH
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertState {
  ACTIVE
  MUTED
  TRIGGERED
  FAILED
}

enum AlertChannel {
  EMAIL
  SLACK
  DISCORD
  TELEGRAM
  WEBHOOK
}

enum WorkflowStatus {
  PASSING
  FAILED
  CANCELLED
  RUNNING
}

enum SecuritySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum SecurityCategory {
  DEPENDABOT
  CODE_SCANNING
  SECRET_SCANNING
}
